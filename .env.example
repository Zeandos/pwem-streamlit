# PWEM environment settings — copy this file to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is git-ignored: NEVER commit it (it may contain local paths or
# credentials). This file only holds the configuration KEYS as placeholders.
#

# Location of the SQLite database.
# Leave empty to use the default <project>/data/pwem_crystals.db
# (the directory and the database itself are created automatically on first run).
PWEM_DB_PATH=
